# GEMINI_API_KEY: Required for Gemini AI API calls.
# Never commit your real API key. Copy this file to .env for local development.
GEMINI_API_KEY="YOUR_GEMINI_API_KEY"

# PORT: HTTP server port (defaults to 3000)
PORT="3000"

# APP_URL: Public URL where IND AGENT is hosted (used for OAuth / CORS origin checks)
APP_URL="http://localhost:3000"

# Server-side AES-256-GCM encryption key for per-user OAuth tokens (any strong 32+ char secret)
TOKEN_ENCRYPTION_KEY=""

# Optional HMAC secret for signing session cookies (generate a random 32+ char hex string in production)
SESSION_SECRET=""

# Optional FamPay / UPI billing defaults (can also be configured in-app by the owner in Plans & Usage)
FAMPAY_UPI_ID=""
FAMPAY_PAYEE_NAME="IND AGENT"
